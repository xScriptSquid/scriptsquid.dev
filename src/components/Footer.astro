---
import { site } from '../config';
import SquidMark from './SquidMark.astro';

const connect = site.links.filter((link) => link.label !== 'Resume');
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="shell">
    <div class="footer-grid">
      <div class="footer-identity">
        <p class="footer-brand">
          <SquidMark class="footer-mark" />
          {site.brand}
        </p>
        <p class="footer-role">{site.name} — {site.role}</p>
        <p class="footer-signoff">{site.signoff}</p>
      </div>

      <nav class="footer-col" aria-labelledby="footer-nav-heading">
        <h2 class="footer-heading" id="footer-nav-heading">Navigate</h2>
        <ul class="footer-links">
          {site.nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
        </ul>
      </nav>

      <div class="footer-col">
        <h2 class="footer-heading" id="footer-connect-heading">Connect</h2>
        <ul class="footer-links" aria-labelledby="footer-connect-heading">
          {connect.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <p>© {year} {site.name}</p>
      <p>Built with <a href="https://astro.build">Astro</a></p>
    </div>
  </div>
</footer>
