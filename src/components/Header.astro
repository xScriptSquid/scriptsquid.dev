---
import { site } from '../config';
import SquidMark from './SquidMark.astro';

const pathname = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
function isCurrent(href: string) {
  if (href === '/') return pathname === '/';
  return pathname === href || pathname.startsWith(href);
}
---

<header class="site-header">
  <div class="shell header-inner">
    <a class="brand" href="/" aria-label={`${site.brand}, home`}>
      <SquidMark class="brand-mark" label={site.brand} />
    </a>
    <nav class="nav" aria-label="Primary">
      {
        site.nav.map((item) => (
          <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
            {item.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>
